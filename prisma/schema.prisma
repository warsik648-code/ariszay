generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  discordId     String?
  role          UserRole  @default(CUSTOMER)
  banned        Boolean   @default(false)
  bannedReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth relations (Better Auth)
  sessions      Session[]
  accounts      Account[]

  // Commerce relations
  orders            Order[]
  referralCode      Referral?         @relation("ReferralOwner")
  referralUsages    ReferralConversion[]
  couponUsages      CouponUsage[]
  internalNotes     AdminNote[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?   // hashed, only for credential provider
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

enum UserRole {
  CUSTOMER
  SUPPORT
  CONTENT_MANAGER
  ANALYST
  ADMIN
  OWNER
}

// ─────────────────────────────────────────────────────────────────────────────
// Product Catalog (DB-backed, seeded from static data)
// ─────────────────────────────────────────────────────────────────────────────

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  cheatsSlug  String   @unique
  name        String
  shortName   String
  description String
  tagline     String
  accent      String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  faqs       Faq[]

  @@map("games")
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  type            ProductType
  name            String
  description     String
  longDescription String        @db.Text
  status          ProductStatus @default(AVAILABLE)
  featured        Boolean       @default(false)
  published       Boolean       @default(true)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id])

  plans        ProductPlan[]
  features     ProductFeature[]
  orderItems   OrderItem[]
  images       ProductImage[]

  @@map("products")
}

model ProductPlan {
  id          String   @id @default(cuid())
  productId   String
  label       String   // e.g. "Monthly", "Lifetime"
  durationDays Int?    // null = lifetime
  price       Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_plans")
}

model ProductFeature {
  id        String  @id @default(cuid())
  productId String
  text      String
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_features")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

enum ProductType {
  CHEAT
  UTILITY
}

enum ProductStatus {
  AVAILABLE
  UPDATING
  UNAVAILABLE
  UNKNOWN
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders & Payments
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  userId          String?
  guestEmail      String?
  guestName       String?
  discordUsername String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  totalAmount     Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  couponCode      String?
  referralCode    String?
  providerOrderId String?       // ID from payment provider
  internalNote    String?
  customerNote    String?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User?           @relation(fields: [userId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  couponUsage  CouponUsage?
  notes        AdminNote[]

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  planId      String?
  productName String  // snapshot at time of order
  planLabel   String? // snapshot at time of order
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int     @default(1)

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
  plan    ProductPlan? @relation(fields: [planId], references: [id])

  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus
  provider       String        // e.g. "stripe", "paypal", "manual"
  providerTxId   String?
  providerData   Json?
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────────────────────────────────────
// Coupons
// ─────────────────────────────────────────────────────────────────────────────

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  maxUsages      Int?
  usageCount     Int          @default(0)
  expiresAt      DateTime?
  active         Boolean      @default(true)
  productIds     String[]     // restrict to specific products (empty = all)
  gameIds        String[]     // restrict to specific games (empty = all)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  orderId   String   @unique
  usedAt    DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@map("coupon_usages")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ─────────────────────────────────────────────────────────────────────────────
// Referrals
// ─────────────────────────────────────────────────────────────────────────────

model Referral {
  id               String   @id @default(cuid())
  code             String   @unique
  ownerId          String   @unique
  commissionPercent Decimal  @db.Decimal(5, 2)
  active           Boolean  @default(true)
  clickCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner       User                 @relation("ReferralOwner", fields: [ownerId], references: [id])
  clicks      ReferralClick[]
  conversions ReferralConversion[]

  @@map("referrals")
}

model ReferralClick {
  id         String   @id @default(cuid())
  referralId String
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@map("referral_clicks")
}

model ReferralConversion {
  id         String  @id @default(cuid())
  referralId String
  userId     String?
  orderId    String
  revenue    Decimal @db.Decimal(10, 2)
  commission Decimal @db.Decimal(10, 2)
  paidOut    Boolean @default(false)

  referral Referral @relation(fields: [referralId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@map("referral_conversions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────────────────────

model BlogPost {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  excerpt        String
  content        String   @db.Text
  category       String
  game           String?
  author         String
  publishedAt    DateTime
  readTimeMinutes Int
  published      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([publishedAt])
  @@map("blog_posts")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  gameId    String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game? @relation(fields: [gameId], references: [id])

  @@map("faqs")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────────────────────────────────────

model AdminNote {
  id        String   @id @default(cuid())
  orderId   String?
  userId    String?
  authorId  String
  body      String   @db.Text
  internal  Boolean  @default(true) // false = visible to customer
  createdAt DateTime @default(now())

  order  Order? @relation(fields: [orderId], references: [id])
  target User?  @relation(fields: [userId], references: [id])

  @@map("admin_notes")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   // admin user who performed the action
  action     String   // e.g. "order.status.update"
  targetType String?  // e.g. "Order"
  targetId   String?
  meta       Json?    // before/after values
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
