generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  discordId     String?
  role          UserRole  @default(CUSTOMER)
  banned        Boolean   @default(false)
  bannedReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions   Session[]
  accounts   Account[]

  orders             Order[]
  referralCode       Referral?            @relation("ReferralOwner")
  referralUsages     ReferralConversion[]
  couponUsages       CouponUsage[]
  internalNotes      AdminNote[]
  tickets            Ticket[]             @relation("TicketCustomer")
  assignedTickets    Ticket[]             @relation("TicketAssignee")
  ticketMessages     TicketMessage[]
  ticketAttachments  TicketAttachment[]
  ticketAssignments  TicketAssignment[]   @relation("AssignmentAssignee")
  ticketAssignerLogs TicketAssignment[]   @relation("AssignmentAssigner")
  supportNotes       InternalNote[]       @relation("InternalNoteAuthor")
  refundRequests     RefundRequest[]      @relation("RefundCustomer")
  refundReviews      RefundRequest[]      @relation("RefundReviewer")
  notifications      Notification[]
  paymentVerifications PaymentVerification[] @relation("PaymentVerificationCustomer")
  paymentVerificationsReviewed PaymentVerification[] @relation("PaymentVerificationReviewer")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

enum UserRole {
  CUSTOMER
  SUPPORT_AGENT
  SUPPORT_MANAGER
  CONTENT_MANAGER
  ANALYST
  ADMIN
  OWNER
}

// ─────────────────────────────────────────────────────────────────────────────
// Product Catalog
// ─────────────────────────────────────────────────────────────────────────────

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  cheatsSlug  String   @unique
  name        String
  shortName   String
  description String
  tagline     String
  accent      String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  faqs     Faq[]

  @@map("games")
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  type            ProductType
  name            String
  description     String
  longDescription String        @db.Text
  status          ProductStatus @default(AVAILABLE)
  featured        Boolean       @default(false)
  published       Boolean       @default(true)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id])

  plans      ProductPlan[]
  features   ProductFeature[]
  orderItems OrderItem[]
  images     ProductImage[]

  @@map("products")
}

model ProductPlan {
  id           String   @id @default(cuid())
  productId    String
  label        String
  durationDays Int?
  price        Decimal  @db.Decimal(10, 2)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_plans")
}

model ProductFeature {
  id        String @id @default(cuid())
  productId String
  text      String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_features")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

enum ProductType {
  CHEAT
  UTILITY
}

enum ProductStatus {
  AVAILABLE
  UPDATING
  UNAVAILABLE
  UNKNOWN
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders & Payments
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String         @id @default(cuid())
  orderNumber     String?        @unique
  userId          String?
  guestEmail      String?
  guestName       String?
  discordUsername String?
  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(UNPAID)
  deliveryStatus  DeliveryStatus @default(PENDING)
  totalAmount     Decimal        @db.Decimal(10, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(10, 2)
  couponCode      String?
  referralCode    String?
  providerOrderId String?
  internalNote    String?
  customerNote    String?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user           User?                @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  couponUsage    CouponUsage?
  notes          AdminNote[]
  statusHistory  OrderStatusHistory[]
  tickets        Ticket[]
  refundRequests RefundRequest[]
  supportNotes   InternalNote[]
  paymentVerifications PaymentVerification[]

  @@index([status])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  planId      String?
  productName String
  planLabel   String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int     @default(1)

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  plan    ProductPlan? @relation(fields: [planId], references: [id])

  @@map("order_items")
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  amount       Decimal       @db.Decimal(10, 2)
  status       PaymentStatus
  provider     String
  providerTxId String?
  providerData Json?
  createdAt    DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PaymentVerification {
  id                   String                    @id @default(cuid())
  orderId              String
  userId               String?
  paymentMethod        String                    @default("REWARBLE_VISA_GIFT_CARD")
  /// AES-GCM encrypted gift card code — never expose except to OWNER/ADMIN via decrypt
  giftCardCodeEncrypted String                   @db.Text
  giftCardLast4        String
  discordUsername      String
  amount               Decimal                   @db.Decimal(10, 2)
  status               PaymentVerificationStatus @default(PENDING)
  internalNote         String?                   @db.Text
  rejectionReason      String?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  verifiedAt           DateTime?
  verifiedById         String?

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User?  @relation("PaymentVerificationCustomer", fields: [userId], references: [id])
  verifiedBy User?  @relation("PaymentVerificationReviewer", fields: [verifiedById], references: [id])

  @@index([status])
  @@index([orderId])
  @@index([createdAt])
  @@map("payment_verifications")
}

model OrderStatusHistory {
  id                 String          @id @default(cuid())
  orderId            String
  fromStatus         OrderStatus?
  toStatus           OrderStatus?
  fromPaymentStatus  PaymentStatus?
  toPaymentStatus    PaymentStatus?
  fromDeliveryStatus DeliveryStatus?
  toDeliveryStatus   DeliveryStatus?
  actorId            String?
  note               String?
  createdAt          DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// Coupons
// ─────────────────────────────────────────────────────────────────────────────

model Coupon {
  id         String       @id @default(cuid())
  code       String       @unique
  type       DiscountType
  value      Decimal      @db.Decimal(10, 2)
  maxUsages  Int?
  usageCount Int          @default(0)
  expiresAt  DateTime?
  active     Boolean      @default(true)
  productIds String[]
  gameIds    String[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String?
  orderId  String   @unique
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@map("coupon_usages")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ─────────────────────────────────────────────────────────────────────────────
// Referrals
// ─────────────────────────────────────────────────────────────────────────────

model Referral {
  id                String   @id @default(cuid())
  code              String   @unique
  ownerId           String   @unique
  commissionPercent Decimal  @db.Decimal(5, 2)
  active            Boolean  @default(true)
  clickCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner       User                 @relation("ReferralOwner", fields: [ownerId], references: [id])
  clicks      ReferralClick[]
  conversions ReferralConversion[]

  @@map("referrals")
}

model ReferralClick {
  id         String   @id @default(cuid())
  referralId String
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@map("referral_clicks")
}

model ReferralConversion {
  id         String  @id @default(cuid())
  referralId String
  userId     String?
  orderId    String
  revenue    Decimal @db.Decimal(10, 2)
  commission Decimal @db.Decimal(10, 2)
  paidOut    Boolean @default(false)

  referral Referral @relation(fields: [referralId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@map("referral_conversions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────────────────────

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  content         String   @db.Text
  category        String
  game            String?
  author          String
  publishedAt     DateTime
  readTimeMinutes Int
  published       Boolean  @default(true)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([publishedAt])
  @@map("blog_posts")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  gameId    String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game? @relation(fields: [gameId], references: [id])

  @@map("faqs")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Support: Tickets, Refunds, Notifications
// ─────────────────────────────────────────────────────────────────────────────

model SequenceCounter {
  name  String @id
  value Int    @default(10000)

  @@map("sequence_counters")
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  userId       String
  orderId      String?
  category     TicketCategory
  status       TicketStatus   @default(NEW)
  priority     TicketPriority @default(NORMAL)
  subject      String
  autoCreated  Boolean        @default(false)
  assignedToId String?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User               @relation("TicketCustomer", fields: [userId], references: [id])
  order        Order?             @relation(fields: [orderId], references: [id])
  assignedTo   User?              @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages     TicketMessage[]
  attachments  TicketAttachment[]
  assignments  TicketAssignment[]
  internalNotes InternalNote[]
  refundRequests RefundRequest[]

  @@index([status])
  @@index([priority])
  @@index([userId])
  @@index([orderId])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String   @db.Text
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  messageId    String?
  uploadedById String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime @default(now())

  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketAssignment {
  id           String   @id @default(cuid())
  ticketId     String
  assigneeId   String
  assignedById String
  createdAt    DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee   User   @relation("AssignmentAssignee", fields: [assigneeId], references: [id])
  assignedBy User   @relation("AssignmentAssigner", fields: [assignedById], references: [id])

  @@index([ticketId])
  @@map("ticket_assignments")
}

model InternalNote {
  id        String   @id @default(cuid())
  ticketId  String?
  orderId   String?
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User    @relation("InternalNoteAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([orderId])
  @@map("internal_notes")
}

model RefundRequest {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  ticketId    String?
  reason      RefundReason
  description String       @db.Text
  status      RefundStatus @default(REQUESTED)
  reviewerId  String?
  reviewNote  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?

  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User    @relation("RefundCustomer", fields: [userId], references: [id])
  ticket   Ticket? @relation(fields: [ticketId], references: [id])
  reviewer User?   @relation("RefundReviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([orderId])
  @@index([userId])
  @@index([createdAt])
  @@map("refund_requests")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

enum TicketCategory {
  ORDER_SUPPORT
  PAYMENT_ISSUE
  REFUND_REQUEST
  TECHNICAL_ISSUE
  ACCOUNT_ISSUE
  OTHER
}

enum TicketStatus {
  NEW
  OPEN
  WAITING_CUSTOMER
  WAITING_STAFF
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RefundStatus {
  REQUESTED
  REVIEWING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundReason {
  NOT_WORKING
  WRONG_PRODUCT
  PAYMENT_ISSUE
  OTHER
}

enum NotificationType {
  ORDER_CREATED
  TICKET_CREATED
  STAFF_REPLIED
  REFUND_UPDATED
  ORDER_COMPLETED
  NEW_ORDER_STAFF
  NEW_TICKET_STAFF
  REFUND_REQUEST_STAFF
  PAYMENT_PENDING_STAFF
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────────────────────────────────────

model AdminNote {
  id        String   @id @default(cuid())
  orderId   String?
  userId    String?
  authorId  String
  body      String   @db.Text
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  order  Order? @relation(fields: [orderId], references: [id])
  target User?  @relation(fields: [userId], references: [id])

  @@map("admin_notes")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
