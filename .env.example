# ─────────────────────────────────────────────────────────────────────────────
# ArisZay - Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Run: docker compose up -d  to start local Postgres
DATABASE_URL=postgresql://ariszay:ariszay_dev_password@localhost:5433/ariszay

# ── Auth (Better Auth) ────────────────────────────────────────────────────
# Generate a random 32+ char secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_random_32_char_secret_minimum
BETTER_AUTH_URL=http://localhost:3000

# ── First Admin Account (seed only — remove from production) ───────────────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=ChangeThisPassword!123
SEED_ADMIN_NAME=Owner

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# Supports: Resend (resend.com), Mailgun, SendGrid, or any SMTP server
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
SMTP_FROM=noreply@yourdomain.com
